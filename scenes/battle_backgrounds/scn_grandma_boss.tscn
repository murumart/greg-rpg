[sub_resource type="Shader" id="Shader_1u14p"]
code = "shader_type canvas_item;

uniform float wow = 0.0;


void fragment() {
	vec2 uv = UV;
	uv.x = fract(uv.x * 4.0 * (1.0 + wow));
	uv.y = fract(uv.y * 4.0);
	uv += vec2(sin(TIME * 0.1), cos(TIME * 0.1));

	uv.x += sin(129.0 + TIME * 0.2 * cos(TIME * 0.03 + uv.x) - sin(uv.y) * 5.0) * 0.02;
	uv.y += sin(TIME * 0.2 * cos(uv.y - TIME * 0.16 + uv.x) - sin(uv.y) * 15.0) * 0.02;
	vec4 colora = texture(TEXTURE, uv);
	float swap = colora.r + 0.8;
	colora.r = colora.b + 0.8;
	colora.b = swap + wow + 0.2;
	uv.x += sin(TIME * 0.2 * cos(TIME * 0.08 + uv.x * wow) - sin(uv.y) * 18.0) * 0.08;
	uv.y += sin(1216.0 + TIME * 0.02 * cos(TIME * 0.08 + uv.y) - sin(uv.x) * 0.4) * 0.02 - wow;


	vec4 color = texture(TEXTURE, uv) * COLOR;
	color.r -= 0.5;
	COLOR = color * colora + colora * 0.1;
}
"

